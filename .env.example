# Supabase (Project Settings → API in the Supabase dashboard)
# These are client-safe settings for the Lunara project. Never use a secret or service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://lumixwmobjvlzgqrdjak.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7tGK_Gg7N5YDFqzC5t2B5A_QjG9H3-v

# RevenueCat (Project settings → API keys, one per store)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Google Sign-In (Google Cloud Console → Credentials → OAuth client IDs)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Sign-In is optional. Without both ids the Google button is hidden and
# the native URL scheme is not registered (see app.config.js) — the app never
# ships a placeholder scheme.
